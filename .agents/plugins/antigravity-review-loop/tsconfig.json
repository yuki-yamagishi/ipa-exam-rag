{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "hooks/**/*.js",
    "skills/**/*.js",
    "state/**/*.js",
    "tests/**/*.ts"
  ]
}
