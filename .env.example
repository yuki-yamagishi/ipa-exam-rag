# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_GENERATE=gemini-3.7-flash
GEMINI_MODEL_EMBEDDING=gemini-embedding-2

# Qdrant Vector Store
# クラスタ名: ipa-exam-rag
QDRANT_URL=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=ipa-exam-rag
# ローカル・テスト環境でインメモリ動作させる場合は空にするか "memory" を指定
# QDRANT_LOCATION=:memory:

# Authentication (secure by default: AUTH_ENABLED defaults to true)
# ローカル開発時のみ false を指定する。Cloud Run 上で false にすると起動拒否される。
AUTH_ENABLED=false
# 本番 (AUTH_ENABLED=true) では必須:
# SESSION_SECRET=<python -c "import secrets; print(secrets.token_hex(32))">
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/callback
# ALLOWED_EMAILS=your-email@gmail.com
